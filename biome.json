{
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAtRules": {
          "level": "off",
          "options": {
            "ignore": [
              "theme",
              "tailwind",
              "apply",
              "layer",
              "custom-variant",
              "config",
              "source",
              "utility",
              "plugin"
            ]
          }
        }
      }
    }
  }
}
